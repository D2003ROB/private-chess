# ---------------------------------------------------------------------------
# Root environment example.
#
# These values configure the Postgres container defined in docker-compose.yml.
# Copy this file to `.env` (never commit `.env`) and adjust if the defaults
# clash with something already running on your machine.
#
# Each app also has its own `.env.example`:
#   apps/api/.env.example
#   apps/web/.env.example
# ---------------------------------------------------------------------------

# Postgres superuser created on first container start.
POSTGRES_USER=chess

# Password for the user above. Placeholder only — never a real secret.
POSTGRES_PASSWORD=chess

# Database created on first container start.
POSTGRES_DB=chess

# Host port the container publishes Postgres on. Change if 5432 is taken.
POSTGRES_PORT=5432
