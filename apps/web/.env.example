# ---------------------------------------------------------------------------
# Web environment example. Copy to `apps/web/.env` (never commit `.env`).
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# ---------------------------------------------------------------------------

# Where the Vite dev server proxies /api and /health. Must match the API's PORT.
# In development the browser talks only to :5173, so there is no CORS involved.
VITE_API_URL=http://localhost:3000
