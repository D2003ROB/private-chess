# ---------------------------------------------------------------------------
# API environment example. Copy to `apps/api/.env` (never commit `.env`).
# Every variable here is read and validated by `src/env.ts` at boot; the API
# exits with a readable message if one is missing or malformed.
# ---------------------------------------------------------------------------

# Postgres connection string. Matches the credentials in docker-compose.yml.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://chess:chess@localhost:5432/chess?schema=public

# Port the Fastify server listens on. The Vite dev proxy assumes 3000.
PORT=3000

# Origin allowed by CORS. In development the Vite proxy means the browser never
# makes a cross-origin request, but this keeps direct calls working.
WEB_ORIGIN=http://localhost:5173

# One of: development | test | production. Controls log formatting.
NODE_ENV=development
